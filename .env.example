# Postgres local do docker compose (porta 5433 para não colidir com outro Postgres na 5432)
DATABASE_URL=postgres://nf:nf@localhost:5433/nf

# claude = extração real; fake = resposta fixa, sem chamar a API (testes e demo offline)
EXTRACTOR=fake
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=claude-sonnet-5-5

# teto de gasto com a API por dia, em dólares
DAILY_BUDGET_USD=1

LOG_LEVEL=info
